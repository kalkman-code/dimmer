    "Downloads and installs signed updates without asking first. Dimmer restores your keyboard and screen brightness before it quits to update." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Downloads and installs signed updates without asking first. Dimmer restores your keyboard and screen brightness before it quits to update."
          }
