          "stringUnit" : {
            "state" : "translated",
            "value" : "El control de pantalla y privacidad continúa. Pausa y reanuda para volver a conectar el teclado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
