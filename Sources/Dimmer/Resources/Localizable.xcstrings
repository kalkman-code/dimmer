    "Restores the blur range and tint to their defaults. Undo with Cmd+Z." : {
      "localizations" : {
        "en-GB" : { "stringUnit" : { "state" : "translated", "value" : "Restores the blur range and tint to their defaults. Undo with Cmd+Z." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Restaura el rango y el tinte del desenfoque a sus valores por omisión. Deshacer con Cmd+Z." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Restaura o intervalo e a tonalidade do desfoque aos valores predefinidos. Desfaça com Cmd+Z." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Setzt den Unschärfebereich und den Farbton auf die Standardwerte zurück. Mit Cmd+Z rückgängig." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rétablit les réglages par défaut de la plage et de la teinte du flou. Annuler avec Cmd+Z." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ぼかしの範囲と色合いをデフォルトに戻します。Cmd+Zで取り消せます。" } }
