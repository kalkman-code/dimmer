    "Restores the zone, snap distance, speed, blur strength and tint. It does not turn snap on or off. Undo with Cmd+Z." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restores the zone, snap distance, speed, blur strength and tint. It does not turn snap on or off. Undo with Cmd+Z."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura la zona, la distancia de cierre, la velocidad, la intensidad del desenfoque y el tinte. No activa ni desactiva el cierre rápido. Deshacer con Cmd+Z."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura a zona, a distância de fechamento, a velocidade, a intensidade do desfoque e a tonalidade. Não ativa nem desativa o fechamento rápido. Desfaça com Cmd+Z."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setzt Zone, Schnappabstand, Tempo, Unschärfestärke und Farbton zurück. Schaltet das schnelle Schließen weder ein noch aus. Mit Cmd+Z widerrufen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablit la zone, la distance de fermeture, la vitesse, l’intensité du flou et la teinte. N’active ni ne désactive la fermeture brusque. Annuler avec Cmd+Z."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゾーン、スナップ距離、速度、ぼかしの強さ、色合いを元に戻します。スナップのオン・オフは変わりません。Cmd+Zで取り消せます。"
          }
        }
      }
    },
    "Restore privacy veil defaults" : {
      "localizations" : {
        "en-GB" : { "stringUnit" : { "state" : "translated", "value" : "Restore privacy veil defaults" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Restaurar el velo de privacidad" } },
