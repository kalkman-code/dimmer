    "Fades the keyboard and screen to off from any app. Unassigned until you record one. Typing, the trackpad or moving the lid brings them back." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fades the keyboard and screen to off from any app. Unassigned until you record one. Typing, the trackpad or moving the lid brings them back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga gradualmente el teclado y la pantalla desde cualquier app. No está asignado hasta que grabes un atajo. Al escribir, usar el trackpad o mover la tapa, vuelven a encenderse."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apaga gradualmente o teclado e a tela em qualquer app. Fica sem atalho até você gravar um. Digitar, usar o trackpad ou mover a tampa os acende novamente."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blendet Tastatur und Bildschirm in jeder App aus. Bis zur Aufzeichnung nicht belegt. Tippen, Trackpad oder Deckelbewegung schalten sie wieder ein."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Éteint progressivement le clavier et l’écran depuis toute app. Aucun raccourci avant enregistrement. La saisie, le trackpad ou le mouvement du couvercle les rallume."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どのアプリからでもキーボードと画面を徐々に消灯します。ショートカットを記録するまで未割り当てです。入力、トラックパッドの操作、またはふたを動かすと再び点灯します。"
          }
        }
      }
    },
    "Fades the keyboard and screen to off from any app. Unassigned until you record one. Typing or using the trackpad brings them back." : {
      "localizations" : {
        "en-GB" : { "stringUnit" : { "state" : "translated", "value" : "Fades the keyboard and screen to off from any app. Unassigned until you record one. Typing or using the trackpad brings them back." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Apaga gradualmente el teclado y la pantalla desde cualquier app. No está asignado hasta que grabes un atajo. Al escribir o usar el trackpad, vuelven a encenderse." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Apaga gradualmente o teclado e a tela em qualquer app. Fica sem atalho até você gravar um. Digitar ou usar o trackpad os acende novamente." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Blendet Tastatur und Bildschirm in jeder App aus. Bis zur Aufzeichnung nicht belegt. Tippen oder die Verwendung des Trackpads schalten sie wieder ein." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Éteint progressivement le clavier et l’écran depuis toute app. Aucun raccourci avant enregistrement. La saisie ou l’utilisation du trackpad les rallume." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "どのアプリからでもキーボードと画面を徐々に消灯します。ショートカットを記録するまで未割り当てです。入力またはトラックパッドの操作で再び点灯します。" } }
      }
    },
