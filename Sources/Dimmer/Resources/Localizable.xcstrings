            "state" : "translated",
            "value" : "Slower closes pass through without blurring."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cerrar más despacio, se pasa de largo sin desenfocar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fechamentos mais lentos passam sem desfocar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei langsamerem Schließen wird die Zone ohne Unschärfe durchlaufen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
