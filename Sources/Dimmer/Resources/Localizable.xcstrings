    "Snap the lid down into the zone and every screen frosts at once. Typing, touching the trackpad or mouse, or pushing the lid back up clears it." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Snap the lid down into the zone and every screen frosts at once. Typing, touching the trackpad or mouse, or pushing the lid back up clears it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baja la tapa de golpe hasta la zona y todas las pantallas se escarchan al instante. Escribir, tocar el trackpad o el ratón, o volver a levantar la tapa quita el efecto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixe a tampa rapidamente até a zona e todas as telas ficam foscas de uma vez. Digitar, tocar no trackpad ou no mouse, ou levantar a tampa remove o efeito."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließe den Deckel schnell bis in die Zone, und jeder Bildschirm wird sofort mattiert. Tippen, Berühren des Trackpads oder der Maus sowie erneutes Öffnen des Deckels heben den Effekt auf."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abaissez vivement le couvercle jusque dans la zone pour givrer tous les écrans instantanément. La saisie, le contact avec le trackpad ou la souris, ou la réouverture du couvercle efface l’effet."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ふたを素早くゾーンまで閉じると、すべての画面が一斉にぼかされます。キー入力、トラックパッドやマウスの操作、またはふたを開くと解除されます。"
          }
        }
      }
    },
