    },
    "Sets the darkness of the angle blur, scaled with its blur strength." : {
      "localizations" : {
        "en-GB" : { "stringUnit" : { "state" : "translated", "value" : "Sets the darkness of the angle blur, scaled with its blur strength." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Define la oscuridad del desenfoque angular según su intensidad." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Define o escurecimento do desfoque por ângulo, proporcional à intensidade." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Legt die Abdunklung der winkelabhängigen Unschärfe entsprechend ihrer Stärke fest." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Règle l’assombrissement du flou selon l’angle, proportionnel à son intensité." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "角度に応じたぼかしの暗さを、その強さに合わせて設定します。" } }
