    "Sets the darkness of the shortcut veil" : {
      "localizations" : {
        "en-GB" : { "stringUnit" : { "state" : "translated", "value" : "Sets the darkness of the shortcut veil" } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Define la oscuridad del velo del atajo" } },
