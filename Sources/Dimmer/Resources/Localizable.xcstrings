    "Drag an end sideways for its angle, up or down for its brightness. Tab selects a value; Return edits it and Escape cancels." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drag an end sideways for its angle, up or down for its brightness. Tab selects a value; Return edits it and Escape cancels."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra un extremo hacia los lados para cambiar el ángulo y arriba o abajo para cambiar el brillo. Tabulador selecciona un valor; Intro lo edita y Esc cancela."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste uma extremidade para os lados para ajustar o ângulo, ou para cima e para baixo para ajustar o brilho. Tab seleciona um valor; Return o edita e Esc cancela."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehe ein Ende seitwärts, um den Winkel zu ändern, und nach oben oder unten, um die Helligkeit anzupassen. Tab wählt einen Wert; Eingabetaste bearbeitet ihn, Escape bricht ab."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser une extrémité horizontalement pour régler son angle, ou verticalement pour régler sa luminosité. Tab sélectionne une valeur ; Entrée la modifie et Échap annule."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "端を左右にドラッグすると角度を、上下にドラッグすると明るさを調整できます。Tabで値を選択し、Returnで編集、Escapeでキャンセルします。"
          }
        }
      }
    },
