    "No readable lid sensor. Privacy veil, Go dark and Keep awake are available." : {
      "localizations" : {
        "en-GB" : { "stringUnit" : { "state" : "translated", "value" : "No readable lid sensor. Privacy veil, Go dark and Keep awake are available." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "No hay un sensor de tapa legible. El velo de privacidad, Apagar y Mantener despierto están disponibles." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Não há um sensor da tampa legível. O véu de privacidade, Escurecer e Manter acordado estão disponíveis." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Kein auslesbarer Deckelsensor. Datenschutzschleier, Abdunkeln und Wach halten sind verfügbar." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Aucun capteur de fermeture lisible. Le voile de confidentialité, Assombrir et Garder éveillé restent disponibles." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "読み取れる蓋センサーがありません。プライバシーベール、画面を暗くする機能、スリープ防止は利用できます。" } }
