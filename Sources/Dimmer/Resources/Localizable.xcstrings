    "Dimmer follows your MacBook’s lid angle to dim the keyboard and screen as it closes." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmer follows your MacBook’s lid angle to dim the keyboard and screen as it closes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmer sigue el ángulo de la tapa del MacBook para atenuar el teclado y la pantalla al cerrarla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dimmer acompanha o ângulo da tampa do MacBook para reduzir o brilho do teclado e da tela ao fechá-la."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmer folgt dem Öffnungswinkel deines MacBook-Deckels und dimmt beim Schließen Tastatur und Bildschirm."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmer suit l’angle du couvercle de votre MacBook et atténue le clavier et l’écran à mesure qu’il se ferme."
          }
