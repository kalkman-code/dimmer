    "Resume keyboard dimming" : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resume keyboard dimming"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reanudar la atenuación del teclado"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Retomar o escurecimento do teclado"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastaturdimmen fortsetzen"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reprendre la gradation du clavier"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードの調光を再開"
          }
        }
      }
    },
    "Hands the keyboard backlight back to Dimmer. Screen dimming and privacy control are not interrupted." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hands the keyboard backlight back to Dimmer. Screen dimming and privacy control are not interrupted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve a Dimmer el control de la retroiluminación del teclado. La atenuación de la pantalla y el control de privacidad continúan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devolve ao Dimmer o controle da retroiluminação do teclado. O escurecimento da tela e o controle de privacidade continuam."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Übergibt die Tastaturbeleuchtung wieder an Dimmer. Bildschirmdimmen und Sichtschutz laufen weiter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rend le rétroéclairage du clavier à Dimmer. L’écran et le contrôle de confidentialité continuent."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードのバックライト制御をDimmerに戻します。画面の調光とプライバシー制御は中断されません。"
          }
        }
      }
    },
    "Screen and privacy control continue. Choose Resume keyboard dimming in the menu bar panel to reconnect the keyboard." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen and privacy control continue. Choose Resume keyboard dimming in the menu bar panel to reconnect the keyboard."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El control de la pantalla y la privacidad continúa. Elige «Reanudar la atenuación del teclado» en el panel de la barra de menús para volver a conectar el teclado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O controle da tela e da privacidade continua. Escolha “Retomar o escurecimento do teclado” no painel da barra de menus para reconectar o teclado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirm und Sichtschutz laufen weiter. Wählen Sie im Menüleistenbereich „Tastaturdimmen fortsetzen“, um die Tastatur wieder zu verbinden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran et la confidentialité restent actifs. Choisissez « Reprendre la gradation du clavier » dans le panneau de la barre des menus pour reconnecter le clavier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面とプライバシー制御は続行します。メニューバーのパネルで「キーボードの調光を再開」を選ぶと、キーボードを再接続します。"
          }
        }
      }
    },
    "Waiting for the lid to open fully once before dimming the screen." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting for the lid to open fully once before dimming the screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando a que la tapa se abra por completo una vez antes de atenuar la pantalla."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando a tampa abrir completamente uma vez antes de escurecer a tela."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wartet auf ein vollständiges Öffnen des Deckels, bevor der Bildschirm gedimmt wird."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En attente d’une ouverture complète du couvercle avant d’atténuer l’écran."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面を暗くする前に、ふたが一度全開になるのを待っています。"
          }
        }
      }
    },
    "Restoring your screen brightness. Dimmer will keep retrying." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restoring your screen brightness. Dimmer will keep retrying."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restableciendo el brillo de la pantalla. Dimmer seguirá intentándolo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaurando o brilho da tela. O Dimmer continuará tentando."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirmhelligkeit wird wiederhergestellt. Dimmer versucht es weiter."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablissement de la luminosité. Dimmer réessaiera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "画面の明るさを戻しています。Dimmerは引き続き再試行します。"
          }
        }
      }
    },
    "Dimmer cannot control this screen's brightness right now." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmer cannot control this screen's brightness right now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmer no puede controlar el brillo de esta pantalla en este momento."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Dimmer não pode controlar o brilho desta tela no momento."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmer kann die Helligkeit dieses Bildschirms gerade nicht steuern."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmer ne peut pas régler la luminosité de cet écran pour le moment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在、Dimmerはこの画面の明るさを調整できません。"
          }
        }
      }
    },
    "Pause and Quit hand brightness back to you. Quitting restores the keyboard even while macOS has dimmed it. Keep awake prevents idle sleep for the time you choose; it does not keep a closed MacBook awake." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pause and Quit hand brightness back to you. Quitting restores the keyboard even while macOS has dimmed it. Keep awake prevents idle sleep for the time you choose; it does not keep a closed MacBook awake."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar y salir te devuelven el control del brillo. Al salir se restaura el teclado, aunque macOS lo haya atenuado. Mantener activo evita la suspensión por inactividad durante el tiempo que elijas; no mantiene activo un MacBook cerrado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausar e encerrar devolvem o controle do brilho a você. Ao encerrar, o teclado é restaurado mesmo que o macOS o tenha escurecido. Manter desperto evita a suspensão por inatividade pelo tempo escolhido; não mantém um MacBook fechado desperto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausieren und Beenden geben die Helligkeitssteuerung zurück. Beim Beenden wird die Tastatur auch dann wiederhergestellt, wenn macOS sie gedimmt hat. „Wach halten“ verhindert den Ruhezustand für die gewählte Zeit, nicht bei geschlossenem MacBook."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suspendre et quitter vous rendent le contrôle de la luminosité. Quitter rétablit le clavier, même si macOS l’a atténué. « Maintenir éveillé » évite la veille pendant la durée choisie, mais pas si le MacBook est fermé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一時停止または終了すると、明るさの制御が戻ります。終了すると、macOSがキーボードを暗くしていても元に戻ります。「スリープを防止」は選んだ時間だけアイドル時のスリープを防ぎますが、MacBookを閉じた状態では防げません。"
          }
        }
      }
    },
    "In Settings, turn off Launch at Login. Quit Dimmer to restore brightness, automatic keyboard brightness and screen colour (even while macOS has dimmed the keyboard). Check that brightness has returned before moving Dimmer from Applications to the Bin in Finder.\n\nOptional cleanup after restoration and quitting: remove Dimmer’s preferences and any remaining recovery files at the paths below. If the keyboard did not come back, the recovery file stays and reopening Dimmer finishes it." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In Settings, turn off Launch at Login. Quit Dimmer to restore brightness, automatic keyboard brightness and screen colour (even while macOS has dimmed the keyboard). Check that brightness has returned before moving Dimmer from Applications to the Bin in Finder.\n\nOptional cleanup after restoration and quitting: remove Dimmer’s preferences and any remaining recovery files at the paths below. If the keyboard did not come back, the recovery file stays and reopening Dimmer finishes it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Ajustes, desactiva «Abrir al iniciar sesión». Sal de Dimmer para restaurar el brillo, el brillo automático del teclado y el color de la pantalla (aunque macOS haya atenuado el teclado). Comprueba que se haya restaurado el brillo antes de mover Dimmer de Aplicaciones a la Papelera en Finder.\n\nLimpieza opcional después de restaurar y salir: elimina las preferencias de Dimmer y los archivos de recuperación que queden en las rutas siguientes. Si el teclado no se restauró, el archivo de recuperación permanece; vuelve a abrir Dimmer para completar el proceso."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em Ajustes, desative “Abrir no Início da Sessão”. Encerre o Dimmer para restaurar o brilho, o brilho automático do teclado e a cor da tela (mesmo que o macOS tenha escurecido o teclado). Confira se o brilho voltou antes de mover o Dimmer de Aplicativos para o Lixo no Finder.\n\nLimpeza opcional após restaurar e encerrar: remova as preferências do Dimmer e os arquivos de recuperação restantes nos caminhos abaixo. Se o teclado não voltar, o arquivo de recuperação permanece; abra o Dimmer novamente para concluir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deaktivieren Sie in den Einstellungen „Beim Anmelden öffnen“. Beenden Sie Dimmer, um Helligkeit, automatische Tastaturbeleuchtung und Bildschirmfarben wiederherzustellen (auch wenn macOS die Tastatur gedimmt hat). Prüfen Sie, ob die Helligkeit zurück ist, bevor Sie Dimmer im Finder aus „Programme“ in den Papierkorb bewegen.\n\nOptionale Bereinigung nach dem Wiederherstellen und Beenden: Entfernen Sie Dimmers Einstellungen und verbliebene Wiederherstellungsdateien an den unten genannten Pfaden. Falls die Tastatur nicht zurückgesetzt wurde, bleibt die Wiederherstellungsdatei erhalten. Öffnen Sie Dimmer erneut, um den Vorgang abzuschließen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans Réglages, désactivez « Ouvrir à la session ». Quittez Dimmer pour rétablir la luminosité, le réglage automatique du clavier et les couleurs de l’écran (même si macOS a atténué le clavier). Vérifiez le retour de la luminosité avant de déplacer Dimmer d’Applications vers la Corbeille dans le Finder.\n\nNettoyage facultatif après restauration et fermeture : supprimez les préférences de Dimmer et les fichiers de récupération restants aux emplacements ci-dessous. Si le clavier n’est pas rétabli, le fichier de récupération reste présent ; rouvrez Dimmer pour terminer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」で「ログイン時に起動」をオフにします。Dimmerを終了すると、明るさ、キーボードの自動輝度、画面の色が復元されます（macOSがキーボードを暗くしている場合も同様です）。明るさが戻ったことを確認してから、FinderでDimmerを「アプリケーション」からゴミ箱に移動してください。\n\n復元と終了後の任意の整理：Dimmerの設定と、以下の場所に残っている復元ファイルを削除します。キーボードが復元されなかった場合、復元ファイルは残ります。Dimmerをもう一度開くと処理が完了します。"
          }
        }
      }
    },
    "Brightness range" : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brightness range"
          }
