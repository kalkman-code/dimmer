    "Without a readable lid sensor, Go dark wakes when you type or use the trackpad or mouse." : {
      "localizations" : {
        "en-GB" : { "stringUnit" : { "state" : "translated", "value" : "Without a readable lid sensor, Go dark wakes when you type or use the trackpad or mouse." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Sin un sensor de tapa legible, Apagar se desactiva al escribir o usar el trackpad o el ratón." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Sem um sensor da tampa legível, Escurecer é desativado ao escrever ou usar o trackpad ou o mouse." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Ohne auslesbaren Deckelsensor wird Abdunkeln durch Tippen oder die Verwendung von Trackpad oder Maus beendet." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Sans capteur de fermeture lisible, Assombrir se désactive lorsque vous tapez ou utilisez le trackpad ou la souris." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "読み取れる蓋センサーがない場合、入力またはトラックパッドやマウスの使用で画面の暗転が解除されます。" } }
