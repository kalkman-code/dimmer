          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprovação necessária. Permita o Dimmer em Ajustes do Sistema → Geral → Itens de Início de Sessão e Extensões."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freigabe erforderlich. Erlaube Dimmer unter Systemeinstellungen → Allgemein → Anmeldeobjekte."
