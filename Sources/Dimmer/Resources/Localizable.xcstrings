        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga e instala actualizaciones firmadas sin preguntar. Dimmer restaura el brillo del teclado y la pantalla antes de cerrarse para actualizar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa e instala atualizações assinadas sem perguntar. O Dimmer restaura o brilho do teclado e da tela antes de encerrar para atualizar."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lädt signierte Updates ohne Nachfrage. Dimmer stellt Tastatur- und Bildschirmhelligkeit vor dem Beenden wieder her."
