    "Restores the keyboard range to %lld° off, %lld° full. Undo with Cmd+Z." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restores the keyboard range to %lld° off, %lld° full. Undo with Cmd+Z."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura el rango del teclado: apagado a %lld°, al máximo a %lld°. Deshacer con Cmd+Z."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restaura o intervalo do teclado: desligado a %lld°, máximo a %lld°. Desfaça com Cmd+Z."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tastaturbereich: aus bei %lld°, voll bei %lld°. Mit Cmd+Z widerrufen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rétablit la plage du clavier : éteint à %lld°, maximal à %lld°. Annuler avec Cmd+Z."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボード範囲をオフ %lld°、最大 %lld°に戻します。Cmd+Zで取り消せます。"
          }
        }
      }
    },
    "Restores the screen range to %lld° off, %lld° full. Undo with Cmd+Z." : {
