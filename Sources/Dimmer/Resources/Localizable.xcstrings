    "The Dimmer icon lives in the menu bar. Choose Settings there to adjust the ranges. Opening Dimmer from Applications or Spotlight brings Settings back, even if the icon is hidden." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Dimmer icon lives in the menu bar. Choose Settings there to adjust the ranges. Opening Dimmer from Applications or Spotlight brings Settings back, even if the icon is hidden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El icono de Dimmer está en la barra de menús. Selecciona Ajustes allí para modificar los intervalos. Al abrir Dimmer desde Aplicaciones o Spotlight, vuelven a aparecer los Ajustes aunque el icono esté oculto."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ícone do Dimmer fica na barra de menus. Selecione Ajustes ali para alterar os intervalos. Abrir o Dimmer em Aplicativos ou no Spotlight traz os Ajustes de volta, mesmo que o ícone esteja oculto."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Dimmer-Symbol befindet sich in der Menüleiste. Wähle dort „Einstellungen“, um die Bereiche anzupassen. Wenn du Dimmer über „Programme“ oder Spotlight öffnest, werden die Einstellungen wieder angezeigt, auch wenn das Symbol ausgeblendet ist."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’icône de Dimmer se trouve dans la barre des menus. Choisissez Réglages pour ajuster les plages. Ouvrir Dimmer depuis Applications ou Spotlight réaffiche les réglages, même si l’icône est masquée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmerのアイコンはメニューバーにあります。そこから「設定」を選ぶと範囲を調整できます。アイコンを隠していても、「アプリケーション」またはSpotlightからDimmerを開くと設定が表示されます。"
          }
        }
      }
    },
    "The display returned an invalid brightness value." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The display returned an invalid brightness value."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla devolvió un valor de brillo no válido."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A tela retornou um valor de brilho inválido."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Display hat einen ungültigen Helligkeitswert zurückgegeben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’écran a renvoyé une valeur de luminosité non valide."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイから無効な明るさの値が返されました。"
          }
        }
      }
    },
    "The keyboard backlight automatic mode could not be changed safely." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The keyboard backlight automatic mode could not be changed safely."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo cambiar de forma segura el modo automático de retroiluminación del teclado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível alterar com segurança o modo automático da retroiluminação do teclado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der automatische Modus der Tastaturbeleuchtung konnte nicht sicher geändert werden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de modifier le mode automatique du rétroéclairage du clavier en toute sécurité."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードバックライトの自動モードを安全に変更できませんでした。"
          }
        }
      }
    },
    "The keyboard backlight did not reach the requested brightness." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The keyboard backlight did not reach the requested brightness."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La retroiluminación del teclado no alcanzó el brillo solicitado."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A retroiluminação do teclado não atingiu o brilho solicitado."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tastaturbeleuchtung hat die gewünschte Helligkeit nicht erreicht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le rétroéclairage du clavier n’a pas atteint la luminosité demandée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーボードバックライトが指定した明るさになりませんでした。"
          }
        }
      }
    },
    "The keyboard backlight returned an invalid brightness value." : {
      "localizations" : {
