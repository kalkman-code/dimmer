    "Blurs every screen from any app, even with snap off; any input clears it. Click it to record your own." : {
      "localizations" : {
        "en-GB" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blurs every screen from any app, even with snap off; any input clears it. Click it to record your own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenfoca todas las pantallas desde cualquier app, aunque el cierre rápido esté desactivado; cualquier actividad lo quita. Haz clic para grabar tu propio atajo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desfoca todas as telas em qualquer app, mesmo com o fechamento rápido desativado; qualquer ação remove o efeito. Clique para gravar seu próprio atalho."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stellt jeden Bildschirm in jeder App unscharf, auch wenn „Unschärfe beim schnellen Schließen“ deaktiviert ist. Jede Eingabe hebt den Effekt auf. Klicke hier, um einen eigenen Kurzbefehl aufzuzeichnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Floute tous les écrans dans n’importe quelle app, même si la fermeture brusque est désactivée ; toute saisie l’efface. Cliquez pour enregistrer votre propre raccourci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ふたを素早く閉じてぼかす」がオフでも、どのアプリからでもすべての画面をぼかします。何か入力すると解除されます。クリックしてショートカットを記録してください。"
          }
        }
      }
    },
