        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Define o escurecimento do véu de fechamento rápido" } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Legt die Abdunklung des Schnellschluss-Schleiers fest" } },
