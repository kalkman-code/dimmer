    "Restores blur strength, clear speed and tint. It does not change the shortcut. Undo with Cmd+Z." : {
      "localizations" : {
        "en-GB" : { "stringUnit" : { "state" : "translated", "value" : "Restores blur strength, clear speed and tint. It does not change the shortcut. Undo with Cmd+Z." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Restaura la intensidad del desenfoque, la velocidad de borrado y el tinte. No cambia el atajo. Deshacer con Cmd+Z." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "Restaura a intensidade do desfoque, a velocidade para limpar e a tonalidade. Não altera o atalho. Desfaça com Cmd+Z." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Setzt Unschärfestärke, Löschgeschwindigkeit und Farbton zurück. Der Kurzbefehl bleibt unverändert. Mit Cmd+Z rückgängig." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Rétablit l’intensité du flou, la vitesse d’effacement et la teinte. Le raccourci reste inchangé. Annuler avec Cmd+Z." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "ぼかしの強さ、解除速度、色合いを元に戻します。ショートカットは変わりません。Cmd+Zで取り消せます。" } }
      }
    },
